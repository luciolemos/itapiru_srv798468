# =========================
# Ambiente de execucao
# development exibe detalhes de erro. No servidor publicado, use production.
APP_ENV=development

# Dashboard - UI Defaults
# =========================
# APP_BASE_PATH:
# - vazio no ambiente local com `php -S ... -t public`
# - deixe vazio para detectar automaticamente o subdiretorio publicado
# - defina /itapiru somente se a deteccao automatica nao for aplicavel
APP_BASE_PATH=

# APP_DB_PATH (opcional): caminho absoluto para o banco SQLite.
# Vazio usa var/data/<slug-do-app>.sqlite; neste projeto, var/data/itapiru.sqlite.
APP_DB_PATH=

#
# APP_DEFAULT_THEME (paleta):
# Valores permitidos: blue | red | green | violet | amber
# Exemplo: APP_DEFAULT_THEME=amber
#
# APP_DEFAULT_MODE (modo de cor):
# Valores permitidos: light | dark
# Exemplo: APP_DEFAULT_MODE=light
#
# APP_DEFAULT_DARK_INTENSITY (intensidade do modo dark):
# Valores permitidos: neutral | vivid
# - neutral: dark mais neutro (tingimento mais discreto da paleta)
# - vivid: dark mais vivo (tingimento mais forte da paleta)
# Exemplo: APP_DEFAULT_DARK_INTENSITY=neutral
#
# Observação importante:
# Esses valores definem o padrão inicial da aplicação.
# Se o usuário já tiver preferência salva no navegador (localStorage),
# a preferência salva terá prioridade sobre o padrão do .env.

APP_DEFAULT_THEME=amber
APP_DEFAULT_MODE=light
APP_DEFAULT_DARK_INTENSITY=neutral

# =========================
# Dashboard - Admin
# =========================
# Credenciais iniciais do usuário administrador (usadas somente ao criar um banco SQLite vazio).
# Em produção, ambas são obrigatórias e ADMIN_PASS deve ter pelo menos 12 caracteres.
# Alterações posteriores não modificam contas que já existem no banco.
ADMIN_USER=
ADMIN_PASS=
