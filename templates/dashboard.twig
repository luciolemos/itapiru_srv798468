{% extends 'layouts/base.twig' %}

{% block title %}16º BI Mtz{% endblock %}

{% block content %}
<div class="db-shell">
  {% include 'components/dashboard-sidebar.twig' %}

  <main class="db-main" aria-label="Conteúdo da seção">
    {% include 'components/dashboard-topbar.twig' with {
      lastUpdated: lastUpdated,
      breadcrumbs: [
        { label: 'Dashboard', url: '{{ app_base_path }}' },
        { label: activeSectionMeta.label|label_case }
      ]
    } %}

    <div id="db-content" class="db-main-body">
      {% include 'components/dashboard-content-header.twig' with {
        breadcrumbs: [
          { label: 'Dashboard', url: '{{ app_base_path }}' },
          { label: activeSectionMeta.label|label_case }
        ],
        title: activeSectionMeta.label|label_case,
        subtitle: 'Links para páginas na web, Sistemas/Subsistemas peculiar à Seção'
      } %}

      <section class="db-cards" aria-label="Cards da seção ativa">
        {% for card in cards %}
          <a
            id="card-{{ card.id }}"
            class="db-card db-card--action db-card--standard"
            href="{{ card.href|default('#') }}"
            {% if card.external|default(false) %}target="_blank" rel="noopener noreferrer"{% endif %}
            aria-label="Abrir {{ card.title }}"
          >
            <header class="db-card-head">
              <div class="db-card-title-wrap">
                <span class="db-card-icon" aria-hidden="true"><i class="bi {{ card.icon|default(card.external|default(false) ? 'bi-globe2' : 'bi-pin-angle') }}"></i></span>
                <h3>{{ card.title }}</h3>
              </div>
              {% if card.status is defined and card.status %}
                <span class="db-badge {{ card.status == 'Sistema' ? 'is-critical' : (card.status == 'Externo' ? 'is-warning' : 'is-ok') }}">
                  {{ card.status }}
                </span>
              {% endif %}
            </header>
            {% if card.href is defined and card.href and card.href != '#' %}
              <p class="db-link-url">{{ card.href }}</p>
            {% endif %}
            <p class="db-description">{{ card.description }}</p>
          </a>
        {% else %}
          <article class="db-card db-card-empty">
            <p>Nenhum card cadastrado para esta seção.</p>
          </article>
        {% endfor %}
      </section>

      {% include 'components/dashboard-footer.twig' with {
        lastUpdated: lastUpdated
      } %}
    </div>
  </main>
</div>
{% endblock %}
