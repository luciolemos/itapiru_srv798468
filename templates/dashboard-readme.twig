{% extends 'layouts/base.twig' %}

{% block title %}{{ readmePageTitle|default('Guia do usuário') }} | 16º BI Mtz{% endblock %}

{% block content %}
<div class="db-shell">
  {% include 'components/dashboard-sidebar.twig' %}

  <main class="db-main" aria-label="Conteúdo de documentação">
    {% include 'components/dashboard-topbar.twig' with {
      lastUpdated: lastUpdated,
      breadcrumbs: [
        { label: 'Dashboard', url: '{{ app_base_path }}' },
        { label: readmePageTitle|default('Guia do usuário') }
      ]
    } %}

    <div id="db-content" class="db-main-body">
      {% include 'components/dashboard-content-header.twig' with {
        breadcrumbs: [
          { label: 'Dashboard', url: '{{ app_base_path }}' },
          { label: readmePageTitle|default('Guia do usuário') }
        ],
        title: readmePageTitle|default('Guia do usuário'),
        subtitle: readmePageSubtitle|default('Guia rápido de conteúdo e manutenção do dashboard')
      } %}

      <article class="db-card db-card--standard db-readme-card" aria-label="Conteúdo da documentação">
        <div class="db-readme-content">{{ readmeHtml|raw }}</div>
      </article>

      {% include 'components/dashboard-footer.twig' with {
        lastUpdated: lastUpdated
      } %}
    </div>
  </main>
</div>
{% endblock %}
